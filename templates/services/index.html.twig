{% extends 'base.html.twig' %}

{% block title %}Services index{% endblock %}

{% block body %}
    {% include 'admin/sidebar.html.twig' %}

<div class="flex-1 flex flex-col overflow-hidden">
    {% include 'admin/header.html.twig' %}

    <div class="flex justify-center p-4">
        <div class="w-full max-w-7xl bg-white p-8 rounded-xl shadow-lg">
            <h1 class="text-2xl font-bold mb-4 text-gray-800 text-center">Services Index</h1>


            <!-- Flash Messages -->
            {% include 'admin/flashmessage.html.twig' %}



            <div class="overflow-x-auto bg-gray-100 p-3 rounded-lg shadow-md">
                <table id="servicesTable" class="w-full border-collapse border border-gray-300 bg-white rounded-lg overflow-hidden shadow">
                    <thead class="bg-gray-100 text-gray-700">
                        <tr>
                            <th class="border border-gray-300 px-2 py-2 text-sm font-semibold text-left">Id</th>
                            <th class="border border-gray-300 px-2 py-2 text-sm font-semibold text-left">Name</th>
                            <th class="border border-gray-300 px-2 py-2 text-sm font-semibold text-left">Description</th>
                            <th class="border border-gray-300 px-2 py-2 text-sm font-semibold text-left">Category</th>
                            <th class="border border-gray-300 px-2 py-2 text-sm font-semibold text-left">Price</th>
                            <th class="border border-gray-300 px-2 py-2 text-sm font-semibold text-left">Status</th>
                            <th class="border border-gray-300 px-2 py-2 text-sm font-semibold text-left">Created By</th>
                            <th class="border border-gray-300 px-2 py-2 text-sm font-semibold text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="servicesTableBody" class="divide-y divide-gray-200">
                        {% for service in services %}
                            <tr class="odd:bg-white even:bg-gray-50 hover:bg-gray-100">
                                <td class="border border-gray-300 px-2 py-1 text-center">{{ service.id }}</td>
                                <td class="border border-gray-300 px-2 py-1 font-medium text-gray-900">{{ service.name }}</td>
                                <td class="border border-gray-300 px-4 py-2 text-gray-700">{{ service.description }}</td>
                                <td class="border border-gray-300 px-2 py-1 font-medium text-gray-900">
                                    {{ service.category ? service.category.categoryName : 'No category' }}
                                </td>
                                <td class="border border-gray-300 px-2 py-1 text-gray-700 text-center">₱{{ service.price }}</td>
                                <td class="border border-gray-300 px-2 py-1 text-gray-700 text-center">{{ service.status.value|capitalize }}</td>
                                <td class="border border-gray-300 px-2 py-1 text-gray-700 text-center">{{ service.createdby ? service.createdby.username|capitalize }}</td>
                                <td class="border border-gray-300 px-2 py-1 text-center">
                                    {# Admin can do actions on all services #}
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a href="{{ path('app_services_show', {'id': service.id}) }}" 
                                           class="text-blue-600 hover:text-blue-800 font-semibold">Show</a> <br/>
                                        <a href="{{ path('app_services_edit', {'id': service.id}) }}" 
                                           class="text-yellow-600 hover:text-yellow-800 font-semibold">Edit</a>
                                    
                                    {# Staff can only do actions on their own services #}
                                    {% elseif is_granted('ROLE_STAFF') %}
                                        {% if service.createdby and app.user and service.createdby.id == app.user.id %}
                                            {# Staff can access their own services #}
                                            <a href="{{ path('app_services_show', {'id': service.id}) }}" 
                                               class="text-blue-600 hover:text-blue-800 font-semibold">Show</a> <br/>
                                            <a href="{{ path('app_services_edit', {'id': service.id}) }}" 
                                               class="text-yellow-600 hover:text-yellow-800 font-semibold">Edit</a>
                                        {% else %}
                                            {# Staff can see but not access other staff's services #}
                                            <span class="text-red-500 text-sm font-medium">Not accessible</span>
                                        {% endif %}
                                    
                                    {# For any other roles, no actions available #}
                                    {% else %}
                                        <span class="text-gray-500 text-sm font-medium">No actions available</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="px-4 py-2 text-center text-gray-500 bg-gray-50">
                                    No records found
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-6 text-center">
                {# Both Admin and Staff can create new services #}
                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
                    <a href="{{ path('app_services_new') }}" 
                       class="inline-block px-5 py-2 bg-green-600 text-white rounded-lg shadow hover:bg-green-700">
                        + Create new
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}