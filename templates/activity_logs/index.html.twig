{% extends 'base.html.twig' %}

{% block title %}Activity Logs{% endblock %}

{% block body %}
    {% include 'admin/sidebar.html.twig' %}

    <div class="flex-1 flex flex-col overflow-hidden">

        {% include 'admin/header.html.twig' %}

        <div class="flex justify-center p-8">
            <div class="w-full max-w-5xl bg-white p-8 rounded-xl shadow-lg">
                <h1 class="text-2xl font-bold mb-4 text-gray-800 text-center">Activity Logs</h1>

                <div class="overflow-x-auto bg-gray-100 p-6 rounded-lg shadow-md">
                    <table id="productsTable" class="w-full border-collapse border border-gray-300 bg-white rounded-lg overflow-hidden shadow">
                        <thead class="bg-gray-100 text-gray-700">
                            <tr>
                                <th class="border border-gray-300 px-4 py-2 text-sm font-semibold w-12 text-center">User</th>
                                <th class="border border-gray-300 px-4 py-2 text-sm font-semibold text-left w-40">Role</th>
                                <th class="border border-gray-300 px-4 py-2 text-sm font-semibold text-left w-40">Action</th>
                                <th class="border border-gray-300 px-4 py-2 text-sm font-semibold text-left w-40">Target Data</th>
                                <th class="border border-gray-300 px-4 py-2 text-sm font-semibold text-center w-40">Date & Time</th>
                            </tr>
                        </thead>
                        <tbody id="productsTableBody" class="divide-y divide-gray-200">
                            {% for log in logs %}
                                <tr class="odd:bg-white even:bg-gray-50 hover:bg-gray-100">
                                    <td class="border border-gray-300 px-4 py-2 text-center">{{ log.userid ? log.userid.username : log.username }}</td>
                                    <td class="border border-gray-300 px-4 py-2 font-medium text-gray-900">{{ log.role }}</td>
                                    <td class="border border-gray-300 px-4 py-2 font-medium text-gray-900">{{ log.action }}</td>
                                    <td class="border border-gray-300 px-4 py-2 font-medium text-gray-900">{{ log.targetData }}</td>
                                    <td class="border border-gray-300 px-4 py-2 font-medium text-gray-900">{{ log.datetime|date('Y-m-d h:i A', 'Asia/Manila') }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="px-4 py-2 text-center text-gray-500 bg-gray-50">
                                        No Activity Logs Found
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
