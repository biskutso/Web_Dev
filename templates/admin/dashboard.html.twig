{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="flex h-screen overflow-hidden">

    {% include 'admin/sidebar.html.twig' %}

    <div class="flex-1 flex flex-col overflow-hidden">

        {% include 'admin/header.html.twig' %}

        <!-- Main Content Area -->
        <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-100 p-6">
            {% if app.user %}
            <h2 class="text-xl font-cinzel text-[#1C1C1C] mb-6">Welcome, {{ app.user.userIdentifier }}!</h2>
            {% endif %}

            <!-- KPI Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
                <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-[#C49A41]">
                    <h3 class="text-lg font-montserrat font-medium text-gray-500">Total Products</h3>
                    <p class="text-3xl font-bold text-[#1C1C1C] mt-2">{{ total_products }}</p>
                    {# <p class="text-sm text-green-500 mt-1">+12% from last month</p> #}
                </div>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-blue-500">
                    <h3 class="text-lg font-montserrat font-medium text-gray-500">Total Users</h3>
                    <p class="text-3xl font-bold text-[#1C1C1C] mt-2">{{ total_users }}</p>
                    {# <p class="text-sm text-green-500 mt-1">+3 today</p> #}
                </div>
                <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-red-500">
                    <h3 class="text-lg font-montserrat font-medium text-gray-500">Total Staff</h3>
                    <p class="text-3xl font-bold text-[#1C1C1C] mt-2">{{ role_counts['ROLE_STAFF'] ?? 0 }}</p>
                    {# <p class="text-sm text-red-500 mt-1">2 new requests</p> #}
                </div>
                <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-green-500">
                    <h3 class="text-lg font-montserrat font-medium text-gray-500">Active Users</h3>
                    <p class="text-3xl font-bold text-[#1C1C1C] mt-2">{{ total_active }}</p>
                    {# <p class="text-sm text-green-500 mt-1">+8% from last month</p> #}
                </div>
                {% endif %}
                 {% if is_granted('ROLE_STAFF') %}
                <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-blue-500">
                    <h3 class="text-lg font-montserrat font-medium text-gray-500">Total Services</h3>
                    <p class="text-3xl font-bold text-[#1C1C1C] mt-2">{{ total_services }}</p>
                    {# <p class="text-sm text-green-500 mt-1">+3 today</p> #}
                </div>
                <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-red-500">
                    <h3 class="text-lg font-montserrat font-medium text-gray-500">Total Orders</h3>
                    <p class="text-3xl font-bold text-[#1C1C1C] mt-2">{{ total_orders }}</p>
                    {# <p class="text-sm text-red-500 mt-1">2 new requests</p> #}
                </div>
                <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-green-500">
                    <h3 class="text-lg font-montserrat font-medium text-gray-500">Active Services</h3>
                    <p class="text-3xl font-bold text-[#1C1C1C] mt-2">{{ total_active_serv }}</p>
                    {# <p class="text-sm text-green-500 mt-1">+8% from last month</p> #}
                </div>
                {% endif %}
            </div>

            <!-- Content based on role -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                {% if is_granted('ROLE_ADMIN') %}
                    <!-- Admin sees Recent Activity -->
                    <div class="lg:col-span-2 bg-white p-6 rounded-lg shadow-md">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-xl font-cinzel text-[#1C1C1C]">Recent Activity</h3>
                            {% if recent_logs|length > 0 %}
                            <a href="{{ path('app_activity_logs') }}" class="text-sm text-[#C49A41] hover:underline font-medium">
                                View All →
                            </a>
                            {% endif %}
                        </div>
                        
                        {% if recent_logs is defined and recent_logs|length > 0 %}
                            <ul class="divide-y divide-gray-200">
                                {% for log in recent_logs %}
                                    <li class="py-3 flex items-center justify-between hover:bg-gray-50 transition-colors duration-150">
                                        <div class="flex-1">
                                            <div class="flex items-center gap-2 mb-1">
                                                <span class="font-semibold text-gray-900">
                                                    {{ log.username }}
                                                </span>
                                                <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-600 font-medium">
                                                    {{ log.role|replace({'ROLE_': ''})|split(',')[0] }}
                                                </span>
                                            </div>
                                            <div class="text-gray-700">
                                                <span class="font-medium">{{ log.action }}</span>
                                                {% if log.targetData %}
                                                    <span class="text-gray-600"> - 
                                                        {% if log.targetData|length > 50 %}
                                                            {{ log.targetData|slice(0, 47) }}...
                                                        {% else %}
                                                            {{ log.targetData }}
                                                        {% endif %}
                                                    </span>
                                                {% endif %}
                                            </div>
                                        </div>
                                        <span class="text-sm text-gray-500 whitespace-nowrap ml-4">
                                            {{ log.datetime|date('h:i A', 'Asia/Manila') }}
                                        </span>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <!-- No activity logs message -->
                            <div class="text-center py-8 text-gray-500">
                                <svg class="w-12 h-12 mx-auto text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/>
                                </svg>
                                <p class="text-gray-600">No recent activity</p>
                                <p class="text-sm text-gray-400 mt-1">Activity will appear here as users interact with the system</p>
                            </div>
                        {% endif %}
                    </div>
                {% else %}
                    <!-- Staff sees Date/Time and Working Hours -->
                    <div class="lg:col-span-2 bg-white p-6 rounded-lg shadow-md">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-xl font-cinzel text-[#1C1C1C]">Today's Information</h3>
                            <button onclick="refreshDateTime()" class="text-sm text-[#C49A41] hover:underline font-medium flex items-center gap-1">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                </svg>
                                Refresh
                            </button>
                        </div>
                        
                        <!-- Current Date and Time -->
                        <div class="bg-gray-50 p-6 rounded-lg mb-6">
                            <div class="text-center mb-2">
                                <div id="current-date" class="text-2xl font-bold text-[#1C1C1C] mb-2">
                                    {{ "now"|date("l, F j, Y") }}
                                </div>
                                <div id="current-time" class="text-4xl font-bold text-[#C49A41] font-mono">
                                    {{ "now"|date("h:i:s A", "Asia/Manila") }}
                                </div>
                            </div>
                            <div class="text-center text-gray-500 text-sm mt-3">
                                <div class="flex items-center justify-center gap-2">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    <span>Philippine Time (GMT+8)</span>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Working Hours -->
                        <div class="bg-[#1C1C1C] text-white p-6 rounded-lg">
                            <h4 class="text-lg font-cinzel text-[#C49A41] mb-4">Working Hours</h4>
                            <div class="space-y-4">
                                <div class="flex justify-between items-center border-b border-gray-700 pb-3">
                                    <span class="font-montserrat font-medium">Monday - Friday</span>
                                    <span class="font-mono text-lg font-bold">9:00 AM - 7:00 PM</span>
                                </div>
                                <div class="flex justify-between items-center border-b border-gray-700 pb-3">
                                    <span class="font-montserrat font-medium">Saturday - Sunday</span>
                                    <span class="font-mono text-lg font-bold">9:00 AM - 5:00 PM</span>
                                </div>
                            </div>
                            
                            <!-- Current Status -->
                            {% set now = "now"|date_modify("+8 hours") %} {# Adjust to Philippine Time #}
                            {% set currentHour = now|date("G") %}
                            {% set currentMinute = now|date("i") %}
                            {% set currentDay = now|date("N") %} {# 1 (Mon) to 7 (Sun) #}
                            
                            {% set isOpen = false %}
                            {% set message = "" %}
                            
                            {% if currentDay <= 5 %}
                                {# Monday to Friday: 9 AM to 7 PM #}
                                {% if currentHour >= 9 and currentHour < 19 %}
                                    {% set isOpen = true %}
                                    {% set closingHour = 19 %}
                                    {% set minutesLeft = (closingHour - currentHour) * 60 - currentMinute %}
                                    
                                    {% if minutesLeft <= 60 %}
                                        {% if minutesLeft <= 0 %}
                                            {% set message = "Closing now" %}
                                        {% else %}
                                            {% set message = "Closes in " ~ minutesLeft ~ " minutes" %}
                                        {% endif %}
                                    {% else %}
                                        {% set message = "Open - Closes at 7:00 PM" %}
                                    {% endif %}
                                {% elseif currentHour < 9 %}
                                    {% set hoursUntilOpen = 8 - currentHour %}
                                    {% set minutesUntilOpen = 60 - currentMinute %}
                                    {% if hoursUntilOpen == 1 %}
                                        {% set message = "Opens in " ~ minutesUntilOpen ~ " minutes" %}
                                    {% else %}
                                        {% set message = "Opens at 9:00 AM" %}
                                    {% endif %}
                                {% else %}
                                    {% if currentDay == 5 %}
                                        {% set message = "Opens at 9:00 AM Monday" %}
                                    {% else %}
                                        {% set message = "Opens at 9:00 AM tomorrow" %}
                                    {% endif %}
                                {% endif %}
                            {% else %}
                                {# Saturday and Sunday: 9 AM to 5 PM #}
                                {% if currentHour >= 9 and currentHour < 17 %}
                                    {% set isOpen = true %}
                                    {% set closingHour = 17 %}
                                    {% set minutesLeft = (closingHour - currentHour) * 60 - currentMinute %}
                                    
                                    {% if minutesLeft <= 60 %}
                                        {% if minutesLeft <= 0 %}
                                            {% set message = "Closing now" %}
                                        {% else %}
                                            {% set message = "Closes in " ~ minutesLeft ~ " minutes" %}
                                        {% endif %}
                                    {% else %}
                                        {% set message = "Open - Closes at 5:00 PM" %}
                                    {% endif %}
                                {% elseif currentHour < 9 %}
                                    {% set hoursUntilOpen = 8 - currentHour %}
                                    {% set minutesUntilOpen = 60 - currentMinute %}
                                    {% if hoursUntilOpen == 1 %}
                                        {% set message = "Opens in " ~ minutesUntilOpen ~ " minutes" %}
                                    {% else %}
                                        {% set message = "Opens at 9:00 AM" %}
                                    {% endif %}
                                {% else %}
                                    {% if currentDay == 6 %}
                                        {% set message = "Opens at 9:00 AM tomorrow" %}
                                    {% else %}
                                        {% set message = "Opens at 9:00 AM Monday" %}
                                    {% endif %}
                                {% endif %}
                            {% endif %}
                            
                            <div class="mt-6 pt-4 border-t border-gray-700">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <div class="w-3 h-3 rounded-full {% if isOpen %}bg-green-500 animate-pulse{% else %}bg-red-500{% endif %}"></div>
                                        <span class="font-montserrat font-semibold">
                                            {% if isOpen %}Open Now{% else %}Closed{% endif %}
                                        </span>
                                    </div>
                                    <span class="text-sm text-gray-300">{{ message }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <!-- Quick Actions (Common for both roles) -->
                <div class="bg-white p-6 rounded-lg shadow-md">
                    <h3 class="text-xl font-cinzel text-[#1C1C1C] mb-4">Quick Actions</h3>
                    <div class="space-y-4">
                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
                        <button onclick="window.location.href='{{ path('app_products_new') }}'" class="cursor-pointer w-full bg-[#C49A41] text-[#1C1C1C] p-3 rounded-lg font-montserrat font-semibold border border-[#C49A41] hover:bg-[#b38938] transition-colors duration-200">
                            Create New Product
                        </button>
                        <button onclick="window.location.href='{{ path('app_services_new') }}'" class="cursor-pointer w-full bg-[#1C1C1C] text-[#C49A41] p-3 rounded-lg font-montserrat font-semibold border border-[#C49A41] hover:bg-gray-800 transition-colors duration-200">
                            Add New Service
                        </button>
                        <button onclick="window.location.href='{{ path('app_categories_index') }}'" class="cursor-pointer w-full bg-gray-200 text-gray-700 p-3 rounded-lg font-montserrat font-semibold hover:bg-gray-300 transition-colors duration-200">
                            Manage Categories
                        </button>
                        {% endif %}

                        {% if is_granted('ROLE_ADMIN') %}
                        <button onclick="window.location.href='{{ path('app_user_index') }}'" class="cursor-pointer w-full bg-gray-200 text-gray-700 p-3 rounded-lg font-montserrat font-semibold hover:bg-gray-300 transition-colors duration-200">
                            Manage Users
                        </button>
                        <button onclick="window.location.href='{{ path('app_user_new') }}'" class="cursor-pointer w-full bg-gray-200 text-gray-700 p-3 rounded-lg font-montserrat font-semibold hover:bg-gray-300 transition-colors duration-200">
                            Add New User
                        </button>
                        {% else %}
                        <button onclick="window.location.href='{{ path('app_orders_new') }}'" class="cursor-pointer w-full bg-[#C49A41] text-[#1C1C1C] p-3 rounded-lg font-montserrat font-semibold border border-[#C49A41] hover:bg-[#b38938] transition-colors duration-200">
                            New Order
                        </button>
                        <button onclick="window.location.href='{{ path("app_admin_account") }}'" class="cursor-pointer w-full bg-gray-200 text-gray-700 p-3 rounded-lg font-montserrat font-semibold hover:bg-gray-300 transition-colors duration-200">
                            Manage Account
                        </button>
                        <button onclick="window.location.href='{{ path('app_products_index') }}'" class="cursor-pointer w-full bg-gray-200 text-gray-700 p-3 rounded-lg font-montserrat font-semibold hover:bg-gray-300 transition-colors duration-200">
                            View All Products
                        </button>
                        {% endif %}
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- JavaScript for real-time clock update -->
<script>
function updateDateTime() {
    const now = new Date();
    
    // Create Philippine time
    const phTime = new Date(now.toLocaleString("en-US", {timeZone: "Asia/Manila"}));
    
    // Format date
    const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
    const dateString = phTime.toLocaleDateString('en-US', options);
    
    // Format time
    let hours = phTime.getHours();
    let minutes = phTime.getMinutes();
    let seconds = phTime.getSeconds();
    const ampm = hours >= 12 ? 'PM' : 'AM';
    
    hours = hours % 12;
    hours = hours ? hours : 12; // 0 should be 12
    minutes = minutes < 10 ? '0' + minutes : minutes;
    seconds = seconds < 10 ? '0' + seconds : seconds;
    
    const timeString = hours + ':' + minutes + ':' + seconds + ' ' + ampm;
    
    // Update DOM
    document.getElementById('current-date').textContent = dateString;
    document.getElementById('current-time').textContent = timeString;
}

function refreshDateTime() {
    updateDateTime();
    // Show a quick notification
    const refreshBtn = event.target.closest('button');
    const originalText = refreshBtn.innerHTML;
    refreshBtn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg> Refreshed';
    setTimeout(() => {
        refreshBtn.innerHTML = originalText;
    }, 1000);
}

// Update time every second
if (document.getElementById('current-time')) {
    updateDateTime();
    setInterval(updateDateTime, 1000);
}
</script>
{% endblock %}