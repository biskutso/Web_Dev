{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="flex h-screen overflow-hidden">

    {% include 'admin/sidebar.html.twig' %}

    <div class="flex-1 flex flex-col overflow-hidden">

        {% include 'admin/header.html.twig' %}

        <!-- Main Content Area -->
        <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-100 p-6">
            {% if app.user %}
            <h2 class="text-xl font-cinzel text-[#1C1C1C] mb-6">Welcome, {{ app.user.userIdentifier }}!</h2>
            {% endif %}

            <!-- KPI Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-[#C49A41]">
                    <h3 class="text-lg font-montserrat font-medium text-gray-500">Total Products</h3>
                    <p class="text-3xl font-bold text-[#1C1C1C] mt-2">{{ total_products }}</p>
                    {# <p class="text-sm text-green-500 mt-1">+12% from last month</p> #}
                </div>
                <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-blue-500">
                    <h3 class="text-lg font-montserrat font-medium text-gray-500">Total Users</h3>
                    <p class="text-3xl font-bold text-[#1C1C1C] mt-2">{{ total_users }}</p>
                    {# <p class="text-sm text-green-500 mt-1">+3 today</p> #}
                </div>
                <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-red-500">
                    <h3 class="text-lg font-montserrat font-medium text-gray-500">Total Staff</h3>
                    <p class="text-3xl font-bold text-[#1C1C1C] mt-2">{{ role_counts['ROLE_STAFF'] ?? 0 }}</p>
                    {# <p class="text-sm text-red-500 mt-1">2 new requests</p> #}
                </div>
                <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-green-500">
                    <h3 class="text-lg font-montserrat font-medium text-gray-500">Active Users</h3>
                    <p class="text-3xl font-bold text-[#1C1C1C] mt-2">{{ total_active }}</p>
                    {# <p class="text-sm text-green-500 mt-1">+8% from last month</p> #}
                </div>
            </div>

            <!-- Recent Activity & Quick Actions -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2 bg-white p-6 rounded-lg shadow-md">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-xl font-cinzel text-[#1C1C1C]">Recent Activity</h3>
                        {% if recent_logs|length > 0 %}
                        <a href="{{ path('app_activity_logs') }}" class="text-sm text-[#C49A41] hover:underline font-medium">
                            View All →
                        </a>
                        {% endif %}
                    </div>
                    
                    {% if recent_logs is defined and recent_logs|length > 0 %}
                        <ul class="divide-y divide-gray-200">
                            {% for log in recent_logs %}
                                <li class="py-3 flex items-center justify-between hover:bg-gray-50 transition-colors duration-150">
                                    <div class="flex-1">
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="font-semibold text-gray-900">
                                                {{ log.username }}
                                            </span>
                                            <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-600 font-medium">
                                                {{ log.role|replace({'ROLE_': ''})|split(',')[0] }}
                                            </span>
                                        </div>
                                        <div class="text-gray-700">
                                            <span class="font-medium">{{ log.action }}</span>
                                            {% if log.targetData %}
                                                <span class="text-gray-600"> - 
                                                    {% if log.targetData|length > 50 %}
                                                        {{ log.targetData|slice(0, 47) }}...
                                                    {% else %}
                                                        {{ log.targetData }}
                                                    {% endif %}
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <span class="text-sm text-gray-500 whitespace-nowrap ml-4">
                                        {{ log.datetime|date('H:i A', 'Asia/Manila') }}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <!-- No activity logs message -->
                        <div class="text-center py-8 text-gray-500">
                            <svg class="w-12 h-12 mx-auto text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/>
                            </svg>
                            <p class="text-gray-600">No recent activity</p>
                            <p class="text-sm text-gray-400 mt-1">Activity will appear here as users interact with the system</p>
                        </div>
                    {% endif %}
                </div>

                <div class="bg-white p-6 rounded-lg shadow-md">
                    <h3 class="text-xl font-cinzel text-[#1C1C1C] mb-4">Quick Actions</h3>
                    <div class="space-y-4">
                        <button onclick="window.location.href='{{ path('app_products_new') }}'" class="cursor-pointer w-full bg-[#C49A41] text-[#1C1C1C] p-3 rounded-lg font-montserrat font-semibold border border-[#C49A41] hover:bg-[#b38938] transition-colors duration-200">
                            Create New Product
                        </button>
                        <button onclick="window.location.href='{{ path('app_services_new') }}'" class="cursor-pointer w-full bg-[#1C1C1C] text-[#C49A41] p-3 rounded-lg font-montserrat font-semibold border border-[#C49A41] hover:bg-gray-800 transition-colors duration-200">
                            Add New Service
                        </button>
                        {% if is_granted('ROLE_ADMIN') %}
                        <button onclick="window.location.href='{{ path('app_user_index') }}'" class="cursor-pointer w-full bg-gray-200 text-gray-700 p-3 rounded-lg font-montserrat font-semibold hover:bg-gray-300 transition-colors duration-200">
                            Manage Users
                        </button>
                        <button onclick="window.location.href='{{ path('app_user_new') }}'" class="cursor-pointer w-full bg-gray-200 text-gray-700 p-3 rounded-lg font-montserrat font-semibold hover:bg-gray-300 transition-colors duration-200">
                            Add New User
                        </button>
                        {% elseif is_granted('ROLE_STAFF') %}
                        <button onclick="window.location.href='{{ path('app_services_index') }}'" class="cursor-pointer w-full bg-gray-200 text-gray-700 p-3 rounded-lg font-montserrat font-semibold hover:bg-gray-300 transition-colors duration-200">
                            Manage Services
                        </button>
                        <button onclick="window.location.href='{{ path('app_categories_index') }}'" class="cursor-pointer w-full bg-gray-200 text-gray-700 p-3 rounded-lg font-montserrat font-semibold hover:bg-gray-300 transition-colors duration-200">
                            Manage Categories
                        </button>
                        {% endif %}
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}