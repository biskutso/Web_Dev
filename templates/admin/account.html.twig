{% extends 'base.html.twig' %}

{% block title %}Account Settings{% endblock %}

{% block body %}
<div class="flex min-h-screen w-full">

    {% include 'admin/sidebar.html.twig' %}

    <div class="flex-1 flex flex-col">

        {% include 'admin/header.html.twig' %}

        <!-- Main Content Area -->
        <main class="flex-1 bg-gray-100 p-4 overflow-hidden flex flex-col">
            {% if app.user %}
            <h2 class="text-xl font-cinzel text-[#1C1C1C] mb-4">Managae Account</h2>
            {% endif %}

            <!-- Flash Messages -->
            {% include 'admin/flashmessage.html.twig' %}

            <!-- Main Content Layout - Centered Split Layout -->
            <div class="flex gap-6 flex-1 overflow-hidden justify-center">
                
                <!-- Left Column (Forms) -->
                <div class="w-2/3 max-w-4xl space-y-6 flex flex-col">
                    
                    <!-- Profile Information Card -->
                    <div class="bg-white p-6 rounded-lg shadow shrink-0">
                        <h3 class="text-xl font-cinzel text-[#1C1C1C] mb-6 pb-3 border-b border-gray-200">
                            Profile Information
                        </h3>
                        
                        <form method="POST" action="{{ path('app_admin_account_update') }}">
                            <div class="flex gap-6 mb-6">
                                <div class="w-1/2">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Current Username</label>
                                    <div class="p-3 bg-gray-50 rounded border border-gray-300 text-gray-700 font-medium text-base">
                                        {{ app.user.username }}
                                    </div>
                                </div>

                                <div class="w-1/2">
                                    <label for="username" class="block text-sm font-medium text-gray-700 mb-2">New Username</label>
                                    <input type="text" id="username" name="username" value="{{ app.user.username }}"
                                           class="w-full p-3 border border-gray-300 rounded focus:ring-2 focus:ring-[#C49A41] focus:border-[#C49A41] text-base">
                                    <p class="text-sm text-gray-500 mt-1">Enter your new desired username</p>
                                </div>
                            </div>

                            <div class="pt-4 border-t border-gray-200">
                                <button type="submit" name="update_profile"
                                        class="bg-[#C49A41] text-[#1C1C1C] px-6 py-2.5 rounded-lg font-semibold hover:bg-[#D4AB4A] transition-colors">
                                    Update Profile
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Change Password Card -->
                    <div class="bg-white p-6 rounded-lg shadow shrink-0">
                        <h3 class="text-xl font-cinzel text-[#1C1C1C] mb-6 pb-3 border-b border-gray-200">
                            Change Password
                        </h3>

                        <form method="POST" action="{{ path('app_admin_account_update') }}">
                            <div class="flex gap-6">
                                <!-- New Password Field -->
                                <div class="w-2/5">
                                    <label for="new_password" class="block text-sm font-medium text-gray-700 mb-2">New Password</label>
                                    <div class="relative">
                                        <input type="password" id="new_password" name="new_password" required minlength="6"
                                               class="w-full p-3 pr-10 border border-gray-300 rounded focus:ring-2 focus:ring-[#C49A41] focus:border-[#C49A41] text-base">
                                        <button type="button" class="absolute inset-y-0 right-0 pr-3 flex items-center toggle-password" data-target="new_password">
                                            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                            </svg>
                                        </button>
                                    </div>
                                    <p class="text-sm text-gray-500 mt-1">At least 6 characters</p>
                                </div>

                                <!-- Confirm Password Field -->
                                <div class="w-2/5">
                                    <label for="confirm_password" class="block text-sm font-medium text-gray-700 mb-2">Confirm Password</label>
                                    <div class="relative">
                                        <input type="password" id="confirm_password" name="confirm_password" required
                                               class="w-full p-3 pr-10 border border-gray-300 rounded focus:ring-2 focus:ring-[#C49A41] focus:border-[#C49A41] text-base">
                                        <button type="button" class="absolute inset-y-0 right-0 pr-3 flex items-center toggle-password" data-target="confirm_password">
                                            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>

                                <div class="w-1/5 flex items-end">
                                    <button type="submit" name="change_password"
                                            class="w-full bg-[#1C1C1C] text-[#C49A41] px-4 py-3 rounded-lg font-semibold hover:bg-gray-800 transition-colors">
                                        Change
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Right Column (Account Details) -->
                <div class="w-1/3 max-w-md h-full">
                    <div class="bg-white p-6 rounded-lg shadow h-full overflow-auto">
                        <h3 class="text-xl font-cinzel text-[#1C1C1C] mb-6 pb-3 border-b border-gray-200">Account Details</h3>

                        <div class="space-y-4">
                            <div class="pb-3 border-b border-gray-100">
                                <p class="font-medium text-gray-700 text-sm mb-1">Account Created</p>
                                <div class="text-base text-gray-800 font-medium">
                                    {% if app.user.createdAt %}
                                        <div>{{ app.user.createdAt|date('F j, Y') }}</div>
                                        <div class="text-sm text-gray-600">{{ app.user.createdAt|date('h:i A') }}</div>
                                    {% else %} 
                                        <div>N/A</div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="pb-3 border-b border-gray-100">
                                <p class="font-medium text-gray-700 text-sm mb-1">Account Status</p>
                                <p class="text-base">
                                    {% if app.user.isActive() %}
                                        <span class="text-green-600 font-medium">Active</span>
                                    {% else %}
                                        <span class="text-red-600 font-medium">Inactive</span>
                                    {% endif %}
                                </p>
                            </div>

                            <div class="pb-3 border-b border-gray-100">
                                <p class="font-medium text-gray-700 text-sm mb-1">Role</p>
                                <p class="text-base">
                                    {% if 'ROLE_ADMIN' in app.user.roles %}
                                        <span class="text-[#C49A41] font-medium">Administrator</span>
                                    {% elseif 'ROLE_USER' in app.user.roles %}
                                        <span class="text-blue-600 font-medium">User</span>
                                    {% endif %}
                                </p>
                            </div>

                            <div class="pb-3">
                                <p class="font-medium text-gray-700 text-sm mb-1">User ID</p>
                                <p class="text-base text-gray-800 font-medium">{{ app.user.id }}</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </main>
    </div>
</div>

{% endblock %}