{% extends 'base.html.twig' %}

{% block title %}User Details{% endblock %}

{% block body %}
{% include 'admin/sidebar.html.twig' %}

<div class="flex-1 flex flex-col overflow-hidden">

    {% include 'admin/header.html.twig' %}

    <div class="flex justify-center p-8 mb-10">
        <div class="w-full max-w-3xl bg-white p-8 rounded-xl shadow-lg">
            <h1 class="text-3xl font-bold text-gray-800 text-center">User Details</h1>

            <div class="overflow-hidden rounded-lg shadow-md bg-gray-50 p-6">
                <table class="table-auto w-full mx-auto border border-gray-300 rounded-lg mb-8">
                    <tbody>
                        <tr>
                            <th class="w-40 border border-gray-300 px-4 py-3 text-left bg-gray-100 font-semibold">ID</th>
                            <td class="px-4 py-3 border border-gray-300">{{ user.id }}</td>
                        </tr>
                        <tr>
                            <th class="w-40 border border-gray-300 px-4 py-3 text-left bg-gray-100 font-semibold">Username</th>
                            <td class="px-4 py-3 border border-gray-300">{{ user.username }}</td>
                        </tr>
                        <tr>
                            <th class="w-40 border border-gray-300 px-4 py-3 text-left bg-gray-100 font-semibold">Role</th>
                            <td class="px-4 py-3 border border-gray-300">
                                {% set userRole = user.roles|first|default('ROLE_USER') %}
                                {% if userRole == 'ROLE_ADMIN' %}
                                    <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-medium">Admin</span>
                                {% elseif userRole == 'ROLE_STAFF' %}
                                    <span class="bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-sm font-medium">Staff</span>
                                {% else %}
                                    <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">User</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th class="w-40 border border-gray-300 px-4 py-3 text-left bg-gray-100 font-semibold">Status</th>
                            <td class="px-4 py-3 border border-gray-300">
                                {% if user.status == 'active' %}
                                    <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium">Active</span>
                                {% elseif user.status == 'inactive' %}
                                    <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-medium">Inactive</span>
                                {% else %}
                                    <span class="bg-gray-100 text-gray-800 px-3 py-1 rounded-full text-sm font-medium">{{ user.status }}</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th class="w-40 border border-gray-300 px-4 py-3 text-left bg-gray-100 font-semibold">Created At</th>
                            <td class="px-4 py-3 border border-gray-300">{{ user.createdAt ? user.createdAt|date('Y-m-d H:i:s') : 'N/A' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Action Buttons -->
            <div class="mt-6 flex justify-center space-x-4">
                <a href="{{ path('app_user_index') }}" data-turbo="false" class="px-5 py-2 bg-gray-500 text-white rounded-lg shadow hover:bg-gray-600">
                    ⬅ Back to list
                </a>

                <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="px-5 py-2 bg-blue-600 text-white rounded-lg shadow hover:bg-blue-700">
                    ✏ Edit
                </a>

                {{ include('user/_delete_form.html.twig') }}
            </div>
        </div>
    </div>

</div>

{% endblock %}