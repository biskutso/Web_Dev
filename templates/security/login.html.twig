{% extends 'navbar.html.twig' %}

{% block title %}Log in | La Fábrica Moto{% endblock %}

{% block body %}
    {# --- HERO WITH FORM CARD --- #}
    <section class="hero-section relative min-h-screen flex items-center justify-center py-12">
        {# Form Card Container #}
        <div class="relative z-10 w-full max-w-md mx-4">
            <div class="bg-white rounded-xl shadow-2xl overflow-hidden border border-gray-200">
                {# Card Header #}
                <div class="bg-gradient-to-r from-black to-gray-800 py-10 px-6 text-center">
                    <h1 class="text-3xl text-[#C49A41] font-cinzel font-bold">SIGN IN</h1>
                </div>
                
                {# Card Body #}
                <div class="p-8">
                    <form method="post" class="space-y-6">
                        {% if error %}
                            <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded mb-6">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0">
                                        <svg class="h-5 w-5 text-red-500" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                        </svg>
                                    </div>
                                    <div class="ml-3">
                                        <p class="text-sm text-red-700 font-montserrat">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        {# Form Fields #}
                        <div class="space-y-5">
                            <div>
                                <label for="inputUsername" class="block text-gray-800 mb-2 font-montserrat font-semibold text-sm">
                                    Username
                                </label>
                                <input 
                                    type="text" 
                                    value="{{ last_username }}" 
                                    name="username" 
                                    id="inputUsername" 
                                    class="w-full px-4 py-3 bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#C49A41] focus:border-transparent transition duration-200 font-montserrat"
                                    placeholder="Enter your username"
                                    autocomplete="username" 
                                    required 
                                    autofocus
                                >
                            </div>

                            <div>
                                <label for="inputPassword" class="block text-gray-800 mb-2 font-montserrat font-semibold text-sm">
                                    Password
                                </label>
                                <input 
                                    type="password" 
                                    name="password" 
                                    id="inputPassword" 
                                    class="w-full px-4 py-3 bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#C49A41] focus:border-transparent transition duration-200 font-montserrat"
                                    placeholder="Enter your password"
                                    autocomplete="current-password" 
                                    required
                                >
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="pt-4">
                                <button 
                                    type="submit" 
                                    class="cursor-pointer w-full bg-gray-200 hover:bg-[#C49A41] hover:text-white  font-cinzel font-bold py-3 px-4 rounded-lg shadow-md hover:shadow-lg transition duration-300"
                                >
                                    SIGN IN
                                </button>
                            </div>
                        </div>

                        {# Footer Links #}
                        <div class="text-center pt-6 border-t border-gray-200 mt-6">
                            <p class="text-sm text-gray-600 font-montserrat">
                                Don't have an account? 
                                <a href="{{ path('app_register') }}" class="font-medium text-[#C49A41] hover:text-[#b38734]">
                                    Create one now
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
{% endblock %}