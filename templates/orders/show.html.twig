{% extends 'base.html.twig' %}

{% block title %}Order Details | La Fábrica Moto{% endblock %}

{% block body %}
    {% include 'admin/sidebar.html.twig' %}

    <div class="flex-1 flex flex-col overflow-hidden">
        {% include 'admin/header.html.twig' %}

        <!-- Page Header -->
        <section class="hero-section2 bg-gradient-to-r from-gray-900 to-black relative h-48">
            <div class="hero-content absolute inset-0 bg-black/70 flex flex-col justify-center items-center">
                <h1 class="text-3xl md:text-4xl font-cinzel font-bold text-white mb-4">ORDER DETAILS</h1>
                <p class="text-lg text-gray-300 font-montserrat">
                    Order #{{ order.id }}
                </p>
            </div>
        </section>

        <div class="flex justify-center p-8 mb-10">
            <div class="w-full max-w-4xl bg-white p-8 rounded-xl shadow-lg">
                <h1 class="text-3xl font-bold mb-6 text-gray-800 text-center">Order Information</h1>

                <div class="bg-gray-50 p-6 rounded-lg shadow-md mb-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Order Details</h3>
                            <dl class="space-y-3">
                                <div class="flex justify-between">
                                    <dt class="text-gray-600">Order ID:</dt>
                                    <dd class="font-medium">{{ order.id }}</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-gray-600">Customer:</dt>
                                    <dd class="font-medium">
                                        {% if order.userName %}
                                            {{ order.userName }}
                                        {% elseif order.userNameSnapshot %}
                                            <div class="flex items-center">
                                                <span>{{ order.userNameSnapshot }}</span>
                                                <span class="ml-2 text-xs text-gray-500 bg-gray-100 px-1 py-0.5 rounded">Deleted</span>
                                            </div>
                                        {% else %}
                                            <span class="text-gray-400">Unknown User</span>
                                        {% endif %}
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-gray-600">Created By:</dt>
                                    <dd class="font-medium">
                                        {% if order.createdBy %}
                                            {{ order.createdBy }}
                                        {% else %}
                                            <span class="text-gray-400">N/A</span>
                                        {% endif %}
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-gray-600">Order Date:</dt>
                                    <dd class="font-medium">{{ order.orderCreated ? order.orderCreated|date('Y-m-d | h:i A', 'Asia/Manila') : '' }}</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-gray-600">Quantity:</dt>
                                    <dd class="font-medium">{{ order.quantity }}</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-gray-600">Price:</dt>
                                    <dd class="font-bold text-[#C49A41]">₱{{ order.price|number_format(2) }}</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-gray-600">Total:</dt>
                                    <dd class="font-bold text-lg text-[#C49A41]">₱{{ (order.price * order.quantity)|number_format(2) }}</dd>
                                </div>
                            </dl>
                        </div>
                        
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Item Details</h3>
                            <dl class="space-y-3">
                                {% if order.productName %}
                                    <div class="flex justify-between">
                                        <dt class="text-gray-600">Item Type:</dt>
                                        <dd class="font-medium">
                                            <span class="bg-blue-100 text-blue-800 text-xs px-2 py-0.5 rounded">Product</span>
                                        </dd>
                                    </div>
                                    <div class="flex justify-between">
                                        <dt class="text-gray-600">Product Name:</dt>
                                        <dd class="font-medium">{{ order.productName }}</dd>
                                    </div>
                                {% elseif order.serviceName %}
                                    <div class="flex justify-between">
                                        <dt class="text-gray-600">Item Type:</dt>
                                        <dd class="font-medium">
                                            <span class="bg-purple-100 text-purple-800 text-xs px-2 py-0.5 rounded">Service</span>
                                        </dd>
                                    </div>
                                    <div class="flex justify-between">
                                        <dt class="text-gray-600">Service Name:</dt>
                                        <dd class="font-medium">{{ order.serviceName }}</dd>
                                    </div>
                                {% elseif order.productNameSnapshot %}
                                    <div class="flex justify-between">
                                        <dt class="text-gray-600">Item Type:</dt>
                                        <dd class="font-medium">
                                            <span class="bg-blue-100 text-blue-800 text-xs px-2 py-0.5 rounded">Product</span>
                                        </dd>
                                    </div>
                                    <div class="flex justify-between">
                                        <dt class="text-gray-600">Product Name:</dt>
                                        <dd class="font-medium">
                                            <div class="flex items-center">
                                                <span>{{ order.productNameSnapshot }}</span>
                                                <span class="ml-2 text-xs text-gray-500 bg-gray-100 px-1 py-0.5 rounded">Deleted</span>
                                            </div>
                                        </dd>
                                    </div>
                                {% elseif order.serviceNameSnapshot %}
                                    <div class="flex justify-between">
                                        <dt class="text-gray-600">Item Type:</dt>
                                        <dd class="font-medium">
                                            <span class="bg-purple-100 text-purple-800 text-xs px-2 py-0.5 rounded">Service</span>
                                        </dd>
                                    </div>
                                    <div class="flex justify-between">
                                        <dt class="text-gray-600">Service Name:</dt>
                                        <dd class="font-medium">
                                            <div class="flex items-center">
                                                <span>{{ order.serviceNameSnapshot }}</span>
                                                <span class="ml-2 text-xs text-gray-500 bg-gray-100 px-1 py-0.5 rounded">Deleted</span>
                                            </div>
                                        </dd>
                                    </div>
                                {% else %}
                                    <div class="flex justify-between">
                                        <dt class="text-gray-600">Item Type:</dt>
                                        <dd class="font-medium text-gray-400">Unknown</dd>
                                    </div>
                                    <div class="flex justify-between">
                                        <dt class="text-gray-600">Item Name:</dt>
                                        <dd class="font-medium text-gray-400">No Item Information</dd>
                                    </div>
                                {% endif %}
                                
                                {% if order.categoryName %}
                                    <div class="flex justify-between">
                                        <dt class="text-gray-600">Category:</dt>
                                        <dd class="font-medium">{{ order.categoryName }}</dd>
                                    </div>
                                {% elseif order.categoryNameSnapshot %}
                                    <div class="flex justify-between">
                                        <dt class="text-gray-600">Category:</dt>
                                        <dd class="font-medium">
                                            <div class="flex items-center">
                                                <span>{{ order.categoryNameSnapshot }}</span>
                                                <span class="ml-2 text-xs text-gray-500 bg-gray-100 px-1 py-0.5 rounded">Deleted</span>
                                            </div>
                                        </dd>
                                    </div>
                                {% endif %}
                            </dl>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="mt-6 flex justify-center space-x-4">
                    <a href="{{ path('app_orders_index') }}" 
                    class="px-5 py-2 bg-gray-500 text-white rounded-lg shadow hover:bg-gray-600">
                        ⬅ Back to list
                    </a>
                    
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_orders_edit', {'id': order.id}) }}"
                           class="px-5 py-2 bg-yellow-500 text-white rounded-lg shadow hover:bg-yellow-600">
                            ✏ Edit
                        </a>
                        
                        <form action="{{ path('app_orders_delete', {'id': order.id}) }}" method="post" class="inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                            <button type="submit" 
                                    onclick="return confirm('Are you sure you want to delete this order? This action cannot be undone.')"
                                    class="px-5 py-2 bg-red-500 text-white rounded-lg shadow hover:bg-red-600">
                                🗑 Delete
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}