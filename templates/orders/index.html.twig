{% extends 'base.html.twig' %}

{% block title %}Orders Index{% endblock %}

{% block body %}
    {% include 'admin/sidebar.html.twig' %}

    <div class="flex-1 flex flex-col overflow-hidden">
        {% include 'admin/header.html.twig' %}

        <div class="flex justify-center p-8">
            <div class="w-full max-w-7xl bg-white p-8 rounded-xl shadow-lg">
                <h1 class="text-2xl font-bold mb-4 text-gray-800 text-center">
                    {% if is_granted('ROLE_ADMIN') %}
                        All Orders
                    {% elseif is_granted('ROLE_STAFF') %}
                        All Orders
                    {% elseif is_granted('ROLE_USER') %}
                        My Orders
                    {% else %}
                        Orders
                    {% endif %}
                </h1>

                {% include 'admin/flashmessage.html.twig' %}

                <div class="overflow-x-auto bg-gray-100 p-6 rounded-lg shadow-md">
                    <table id="ordersTable" class="w-full border-collapse border border-gray-300 bg-white rounded-lg overflow-hidden shadow">
                        <thead class="bg-gray-100 text-gray-700">
                            <tr>
                                <th class="px-4 py-2">Id</th>
                                <th class="px-4 py-2">User</th>
                                <th class="px-4 py-2">Created By</th>
                                <th class="px-4 py-2">Ordered Item</th>
                                <th class="px-4 py-2">Category</th>
                                <th class="px-4 py-2">Price</th>
                                <th class="px-4 py-2">Qty.</th>
                                <th class="px-4 py-2">Order Created</th>
                                <th class="px-4 py-2 text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody id="ordersTableBody" class="divide-y divide-gray-200">
                            {% if orders is empty %}
                                <tr class="odd:bg-white even:bg-gray-50 hover:bg-gray-100">
                                    <td colspan="9" class="text-center py-3 text-gray-500 bg-gray-50">
                                        No orders found
                                    </td>
                                </tr>
                            {% endif %}

                            {% for order in orders %}
                                <tr class="odd:bg-white even:bg-gray-50 hover:bg-gray-100">

                                    <td class="px-4 py-2 text-center">{{ order.id }}</td>

                                    <td class="px-4 py-2 font-medium">
                                        {% if order.user %}
                                            {{ order.user }}
                                        {% elseif order.userNameSnapshot %}
                                            <div class="flex items-center">
                                                <span>{{ order.userNameSnapshot }}</span>
                                                <span class="ml-2 text-xs text-gray-500 bg-gray-100 px-1 py-0.5 rounded">Deleted</span>
                                            </div>
                                        {% else %}
                                            <span class="text-gray-400">Unknown User</span>
                                        {% endif %}
                                    </td>

                                    <td class="px-4 py-2 font-medium">
                                        {% if order.createdBy %}
                                            {{ order.createdBy }}
                                        {% else %}
                                            <span class="text-gray-400">N/A</span>
                                        {% endif %}
                                    </td>

                                    <td class="px-4 py-2 font-medium">
                                        {% if order.product %}
                                            <div class="flex items-center">
                                                <span class="bg-blue-100 text-blue-800 text-xs px-2 py-0.5 rounded mr-2">Product</span>
                                                <span>{{ order.product }}</span>
                                            </div>
                                        {% elseif order.service %}
                                            <div class="flex items-center">
                                                <span class="bg-purple-100 text-purple-800 text-xs px-2 py-0.5 rounded mr-2">Service</span>
                                                <span>{{ order.service }}</span>
                                            </div>
                                        {% elseif order.productNameSnapshot %}
                                            <div class="flex items-center">
                                                <span class="bg-blue-100 text-blue-800 text-xs px-2 py-0.5 rounded mr-2">Product</span>
                                                <span>{{ order.productNameSnapshot }}</span>
                                                <span class="ml-2 text-xs text-gray-500 bg-gray-100 px-1 py-0.5 rounded">Deleted</span>
                                            </div>
                                        {% elseif order.serviceNameSnapshot %}
                                            <div class="flex items-center">
                                                <span class="bg-purple-100 text-purple-800 text-xs px-2 py-0.5 rounded mr-2">Service</span>
                                                <span>{{ order.serviceNameSnapshot }}</span>
                                                <span class="ml-2 text-xs text-gray-500 bg-gray-100 px-1 py-0.5 rounded">Deleted</span>
                                            </div>
                                        {% else %}
                                            <span class="text-gray-400">N/A</span>
                                        {% endif %}
                                    </td>

                                    <td class="px-4 py-2 font-medium">
                                        {% if order.category %}
                                            {{ order.category }}
                                        {% elseif order.categoryNameSnapshot %}
                                            <div class="flex items-center">
                                                <span>{{ order.categoryNameSnapshot }}</span>
                                                <span class="ml-2 text-xs text-gray-500 bg-gray-100 px-1 py-0.5 rounded">Deleted</span>
                                            </div>
                                        {% else %}
                                            <span class="text-gray-400">N/A</span>
                                        {% endif %}
                                    </td>

                                    <td class="px-4 py-2 font-medium">
                                        ₱{{ order.price|number_format(2) }}
                                    </td>

                                    <td class="px-4 py-2 font-medium">
                                        {{ order.quantity }}
                                    </td>

                                    <td class="px-4 py-2 font-medium">
                                        {{ order.orderCreated|date('Y-m-d h:i A', 'Asia/Manila') }}
                                    </td>

                                    <td class="px-4 py-2 text-center">
                                        <a href="{{ path('app_orders_show', {'id': order.id}) }}" 
                                           class="text-blue-600 hover:text-blue-800 mx-1">Show</a>

                                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
                                            <a href="{{ path('app_orders_edit', {'id': order.id}) }}"
                                               class="text-yellow-600 hover:text-yellow-800 mx-1">Edit</a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="mt-6 text-center">
                    <a href="{{ path('app_orders_new') }}" 
                       class="px-5 py-2 bg-green-600 text-white rounded-lg shadow hover:bg-green-700">
                        + Create new order
                    </a>
                </div>

            </div>
        </div>
    </div>
{% endblock %}