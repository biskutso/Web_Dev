{% extends 'navbar.html.twig' %}

{% block title %}Register | La Fábrica Moto{% endblock %}

{% block body %}
    {# --- HERO WITH FORM CARD --- #}
    <section class="hero-section relative min-h-screen flex items-center justify-center py-12">
        {# Form Card Container #}
        <div class="relative z-10 w-full max-w-md mx-4">
            <div class="bg-white rounded-xl shadow-2xl overflow-hidden border border-gray-200 mt-6">
                {# Card Header #}
                <div class="bg-gradient-to-r from-black to-gray-800 mt-6 py-10 px-6 text-center">
                    <h1 class="text-3xl font-cinzel font-bold ">JOIN US</h1>
                </div>
                
                {# Card Body #}
                <div class="p-8">
                    {% if app.user %}
                        <div class="bg-green-50 border-l-4 border-green-500 p-4 rounded mb-6">
                            <div class="flex items-center">
                                <div class="flex-shrink-0">
                                    <svg class="h-5 w-5 text-green-500" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm text-green-700 font-montserrat">
                                        You are logged in as <span class="font-semibold">{{ app.user.username }}</span>, 
                                        <a href="{{ path('app_logout') }}" class="font-medium text-green-700 hover:text-green-600 underline ml-1">Logout</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    {{ form_start(registrationForm, {'attr': {'class': 'space-y-6'}}) }}
                        
                        {% if not registrationForm.vars.valid %}
                            <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded mb-6">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0">
                                        <svg class="h-5 w-5 text-red-500" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                        </svg>
                                    </div>
                                    <div class="ml-3">
                                        <p class="text-sm text-red-700 font-montserrat">Please fix the errors below</p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        {# Form Fields #}
                        <div class="space-y-5">
                            <div>
                                <label class="block text-gray-800 mb-2 font-montserrat font-semibold text-sm">
                                    Username
                                </label>
                                {{ form_widget(registrationForm.username, {
                                    'attr': {
                                        'class': 'w-full px-4 py-3 bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#C49A41] focus:border-transparent transition duration-200 font-montserrat',
                                        'placeholder': 'Choose a username'
                                    }
                                }) }}
                                <div class="text-red-500 text-sm mt-1 font-montserrat">
                                    {{ form_errors(registrationForm.username) }}
                                </div>
                            </div>

                            <div>
                                <label class="block text-gray-800 mb-2 font-montserrat font-semibold text-sm">
                                    Password
                                </label>
                                {{ form_widget(registrationForm.plainPassword, {
                                    'attr': {
                                        'class': 'w-full px-4 py-3 bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#C49A41] focus:border-transparent transition duration-200 font-montserrat',
                                        'placeholder': 'Create a strong password'
                                    }
                                }) }}
                                <div class="text-red-500 text-sm mt-1 font-montserrat">
                                    {{ form_errors(registrationForm.plainPassword) }}
                                </div>
                                <p class="text-xs text-gray-500 mt-1 font-montserrat">
                                    Use at least 8 characters with a mix of letters, numbers & symbols
                                </p>
                            </div>

                            <div class="flex items-start pt-2">
                                <div class="flex items-center h-5">
                                    {{ form_widget(registrationForm.agreeTerms, {
                                        'attr': {
                                            'class': 'h-4 w-4 text-[#C49A41] focus:ring-[#C49A41] border-gray-300 rounded'
                                        }
                                    }) }}
                                </div>
                                <div class="ml-3">
                                    <label class="text-sm text-gray-700 font-montserrat">
                                        {{ form_label(registrationForm.agreeTerms) }}
                                    </label>
                                    <div class="text-red-500 text-sm mt-1 font-montserrat">
                                        {{ form_errors(registrationForm.agreeTerms) }}
                                    </div>
                                </div>
                            </div>

                            <div class="pt-4">
                                <button 
                                    type="submit" 
                                    class="w-full bg-gradient-to-r from-black to-gray-800 hover:from-gray-800 hover:to-black text-white font-cinzel font-bold py-3 px-4 rounded-lg shadow-md hover:shadow-lg transition duration-300"
                                >
                                    CREATE ACCOUNT
                                </button>
                            </div>
                        </div>

                        {# Footer Links #}
                        <div class="text-center pt-6 border-t border-gray-200 mt-6">
                            <p class="text-sm text-gray-600 font-montserrat">
                                Already have an account? 
                                <a href="{{ path('app_login') }}" class="font-medium text-[#C49A41] hover:text-[#b38734]">
                                    Sign in here
                                </a>
                            </p>
                        </div>
                    {{ form_end(registrationForm) }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}